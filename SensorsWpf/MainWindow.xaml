<Window x:Class="SensorsWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SensorsWpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Sensors"
        Height="600"
        Width="600"
        MinHeight="500"
        MinWidth="500">
    <Window.Resources>
        <local:StatusToBrushConverter x:Key="statusToBrush"/>
        <local:AbsoluteToRelativeXConverter x:Key="absToRelX"/>
        <local:AbsoluteToRelativeYConverter x:Key="absToRelY"/>
        <local:BallDataSourceConverter x:Key="ballDatgaSource"/>

        <DataTemplate x:Key="Sensor" DataType="local:SensorData">
            <StackPanel>
                <WrapPanel>
                    <Ellipse Width="12" Height="12"
                             Margin="4,2,0,2"
                             Fill="{Binding Status, Converter={StaticResource statusToBrush}}"/>
                    <Label Content="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="12"/>
                </WrapPanel>
                <TextBlock Text="{Binding Info}"
                           FontSize="14"
                           Margin="8,4"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="4" Rows="1">
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding SimpleOrientation}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Activity}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Proximity}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding HingeAngle}"/>
        </UniformGrid>
        <Grid Grid.Row="1">
            <Grid.Resources>
                <Style TargetType="RadioButton">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Margin" Value="4,8"/>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="Margin" Value="4,12"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="0"
                             Content="{Binding Accelerometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="0"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDatgaSource}, ConverterParameter={x:Static local:BallDataSource.Accelerometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="1"
                             Content="{Binding Gyrometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="1"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDatgaSource}, ConverterParameter={x:Static local:BallDataSource.Gyrometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="2" 
                             Content="{Binding Inclinometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="2"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDatgaSource}, ConverterParameter={x:Static local:BallDataSource.Inclinometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="3"
                             Content="{Binding Orientation}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="3"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDatgaSource}, ConverterParameter={x:Static local:BallDataSource.Orientation}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="4" 
                             Content="{Binding Magnetometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="4"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDatgaSource}, ConverterParameter={x:Static local:BallDataSource.Magnetometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="5"
                             Content="{Binding Pedometer}"/>
                <Separator Grid.Column="1" Grid.Row="5"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="6"
                             Content="{Binding HumanPresence}"/>
                <Separator Grid.Column="1" Grid.Row="6"/>
            </Grid>
            <Canvas x:Name="PhantomCanvas" Grid.Column="1"/>
            <Canvas Grid.Column="1"
                    Background="AliceBlue">
                <Ellipse Grid.Column="1" Width="10" Height="10" Fill="Blue"
                         Canvas.Left="{Binding Ball.X, Converter={StaticResource absToRelX}, ConverterParameter={x:Reference PhantomCanvas}}"
                         Canvas.Top="{Binding Ball.Y, Converter={StaticResource absToRelY}, ConverterParameter={x:Reference PhantomCanvas}}"/>
            </Canvas>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="4" Rows="1">
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Altimeter}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Barometer}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Compass}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Light}"/>
        </UniformGrid>
    </Grid>
</Window>
