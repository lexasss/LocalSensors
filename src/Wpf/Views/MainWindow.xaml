<Window x:Class="SensorsWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SensorsWpf.Models"
        xmlns:conv="clr-namespace:SensorsWpf.Converters"
        xmlns:enums="clr-namespace:SensorsWpf.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Language="en-US"
        Title="Sensors"
        Height="600"
        Width="700"
        MinHeight="500"
        MinWidth="600"
        Icon="/Assets/Images/icon.png">
    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="statusToBrush"/>
        <conv:BallDataSourceConverter x:Key="ballDataSource"/>

        <DataTemplate x:Key="Sensor" DataType="models:SensorData">
            <StackPanel>
                <WrapPanel>
                    <Ellipse Width="12" Height="12"
                             Margin="4,2,0,2"
                             Fill="{Binding Status, Converter={StaticResource statusToBrush}}"/>
                    <Label Content="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="12"/>
                </WrapPanel>
                <TextBlock Text="{Binding Info}"
                           FontSize="14"
                           FontFamily="Consolas"
                           Margin="8,4"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="4" Rows="1">
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding SimpleOrientation}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Activity}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Proximity}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding HingeAngle}"/>
        </UniformGrid>
        <Grid Grid.Row="1">
            <Grid.Resources>
                <Style TargetType="RadioButton">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Margin" Value="4,2,10,2"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Width" Value="18"/>
                    <Setter Property="Margin" Value="4,12"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="0"
                             Content="{Binding Accelerometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="0"
                             IsEnabled="{Binding Accelerometer.Status}"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDataSource}, ConverterParameter={x:Static enums:BallDataSource.Accelerometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="1"
                             Content="{Binding Gyrometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="1"
                             IsEnabled="{Binding Gyrometer.Status}"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDataSource}, ConverterParameter={x:Static enums:BallDataSource.Gyrometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="2" 
                             Content="{Binding Inclinometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="2"
                             IsEnabled="{Binding Inclinometer.Status}"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDataSource}, ConverterParameter={x:Static enums:BallDataSource.Inclinometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="3"
                             Content="{Binding Orientation}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="3"
                             IsEnabled="{Binding Orientation.Status}"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDataSource}, ConverterParameter={x:Static enums:BallDataSource.Orientation}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="4" 
                             Content="{Binding Magnetometer}"/>
                <RadioButton GroupName="Ball" Grid.Column="1" Grid.Row="4"
                             IsEnabled="{Binding Magnetometer.Status}"
                             IsChecked="{Binding BallDataSource, Converter={StaticResource ballDataSource}, ConverterParameter={x:Static enums:BallDataSource.Magnetometer}}"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="5"
                             Content="{Binding Pedometer}"/>
                <Separator Grid.Column="1" Grid.Row="5"/>
                <UserControl ContentTemplate="{StaticResource Sensor}" Grid.Column="0" Grid.Row="6"
                             Content="{Binding HumanPresence}"/>
                <Separator Grid.Column="1" Grid.Row="6"/>
            </Grid>
            <Grid Grid.Column="1"
                  Background="AliceBlue">
                <Ellipse Fill="Blue"
                         Width="{Binding BallSize}"
                         Height="{Binding BallSize}"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="{Binding Ball.X}"
                                            Y="{Binding Ball.Y}"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="4" Rows="1">
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Altimeter}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Barometer}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Compass}"/>
            <UserControl ContentTemplate="{StaticResource Sensor}" 
                         Content="{Binding Light}"/>
        </UniformGrid>
    </Grid>
</Window>
